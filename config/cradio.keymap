#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/mouse.h>

// Layers
#define BASE 0
#define NAV  1
#define SYM  2
#define NUM  3
#define GAME 4
#define SYS  5

/ {
    macros {
        template_literal: template_literal_macro {
            compatible = "zmk,behavior-macro";
            label = "TEMPLATE_LITERAL";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp DLLR &kp LBRC &kp RBRC &kp GRAVE>;
        };
        equals_strict: equals_strict_macro {
            compatible = "zmk,behavior-macro";
            label = "EQUALS_STRICT";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp EQUAL &kp EQUAL>;
        };
        not_equal: not_equal_macro {
            compatible = "zmk,behavior-macro";
            label = "NOT_EQUAL";
            #binding-cells = <0>;
            bindings = <&kp EXCL &kp EQUAL &kp EQUAL>;
        };
        and_logical: and_logical_macro {
            compatible = "zmk,behavior-macro";
            label = "AND_LOGICAL";
            #binding-cells = <0>;
            bindings = <&kp AMPS &kp AMPS>;
        };
        or_logical: or_logical_macro {
            compatible = "zmk,behavior-macro";
            label = "OR_LOGICAL";
            #binding-cells = <0>;
            bindings = <&kp PIPE &kp PIPE>;
        };
        arrow: arrow_macro {
            compatible = "zmk,behavior-macro";
            label = "ARROW";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GT>;
        };

        // macOS US layout: Option+E then a vowel gives an acute accent
        acute: acute_macro {
            compatible = "zmk,behavior-macro-one-param";
            label = "ACUTE";
            #binding-cells = <1>;
            bindings = <&macro_tap &kp LA(E) &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
        };
        // macOS US layout: Option+N then n gives ñ
        tilde: tilde_macro {
            compatible = "zmk,behavior-macro-one-param";
            label = "TILDE";
            #binding-cells = <1>;
            bindings = <&macro_tap &kp LA(N) &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
        };
    };

    combos {
        compatible = "zmk,combos";
        #include "combos.dtsi"
    };

    behaviors {
        // Home row mods
        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <100>;
            bindings = <&kp>, <&kp>;
        };
        // Tap = vowel, hold = accented vowel
        ha: hold_tap_accent {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <100>;
            bindings = <&acute>, <&kp>;
        };
        // Tap = n, hold = ñ
        hn: hold_tap_tilde {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <100>;
            bindings = <&tilde>, <&kp>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
        //  Q         W         E´        R         T            Y         U´        I´        O´        P
            &kp Q     &kp W     &ha E E   &kp R     &kp T        &kp Y     &ha U U   &ha I I   &ha O O   &kp P
        //  A´        S⌥        D⌃        F⌘        G            H         J⌘        K⌃        L⌥        '
            &ha A A   &ht LALT S &ht LCTRL D &ht LGUI F &kp G    &kp H     &ht RGUI J &ht RCTRL K &ht RALT L &kp SQT
        //  Z         X         C         V         B            Ñ         M         ,         .         /
            &kp Z     &kp X     &kp C     &kp V     &kp B        &hn N N   &kp M     &kp COMMA &kp DOT   &kp FSLH
        //                      Tab/NAV   Bksp/⇧                 Space/SYM Enter/⇧
                                &lt NAV TAB &ht LSHFT BSPC       &lt SYM SPACE &ht RSHFT RET
            >;
        };

        nav_layer {
            bindings = <
        //  Esc       ⌘⇧[       ⌘⇧]       ⌘`        ⌘Tab         Home      PgDn      PgUp      End       Del
            &kp ESC   &kp LS(LG(LBKT)) &kp LS(LG(RBKT)) &kp LG(GRAVE) &kp LG(TAB)   &kp HOME  &kp PG_DN &kp PG_UP &kp END   &kp DEL
        //  ⌘         ⌥         ⌃         ⇧         ·            ←         ↓         ↑         →         Enter
            &sk LGUI  &sk LALT  &sk LCTRL &sk LSHFT &trans       &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &kp RET
        //  ⌘Z        ⌘X        ⌘C        ⌘V        ⌘⇧Z          Caps      ⌘←        ⌘→        ⌥←        ⌥→
            &kp LG(Z) &kp LG(X) &kp LG(C) &kp LG(V) &kp LS(LG(Z))  &caps_word &kp LG(LEFT) &kp LG(RIGHT) &kp LA(LEFT) &kp LA(RIGHT)
                                &trans    &trans                 &trans    &trans
            >;
        };

        sym_layer {
            bindings = <
        //  !         @         #         $         %            ^         &         *         (         )
            &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET &kp AMPS  &kp ASTRK &kp LPAR  &kp RPAR
        //  `         ~         <         >         ?            -         =         +         {         }
            &kp GRAVE &kp TILDE &kp LT    &kp GT    &kp QMARK    &kp MINUS &kp EQUAL &kp PLUS  &kp LBRC  &kp RBRC
        //  :         ;         "         ¿         ¡            _         |         \         [         ]
            &kp COLON &kp SEMI  &kp DQT   &kp LA(LS(FSLH)) &kp LA(N1)  &kp UNDER &kp PIPE &kp BSLH &kp LBKT  &kp RBKT
                                &trans    &trans                 &trans    &trans
            >;
        };

        num_layer {
            bindings = <
        //  F1        F2        F3        F4        F5           +         7         8         9         *
            &kp F1    &kp F2    &kp F3    &kp F4    &kp F5       &kp PLUS  &kp N7    &kp N8    &kp N9    &kp ASTRK
        //  F6        F7        F8        F9        F10          -         4         5         6         /
            &kp F6    &kp F7    &kp F8    &kp F9    &kp F10      &kp MINUS &kp N4    &kp N5    &kp N6    &kp FSLH
        //  F11       F12       ⌃B (tmux) ⌃C        ⌃R           0         1         2         3         .
            &kp F11   &kp F12   &kp LC(B) &kp LC(C) &kp LC(R)    &kp N0    &kp N1    &kp N2    &kp N3    &kp DOT
                                &trans    &trans                 &trans    &trans
            >;
        };

        // Plain keys only: no hold-tap, no combos
        game_layer {
            bindings = <
        //  Q         W         E         R         T            1         2         3         4         5
            &kp Q     &kp W     &kp E     &kp R     &kp T        &kp N1    &kp N2    &kp N3    &kp N4    &kp N5
        //  A         S         D         F         G            6         7         8         9         0
            &kp A     &kp S     &kp D     &kp F     &kp G        &kp N6    &kp N7    &kp N8    &kp N9    &kp N0
        //  Z         X         C         V         B            M         I         Enter     Esc       EXIT
            &kp Z     &kp X     &kp C     &kp V     &kp B        &kp M     &kp I     &kp RET   &kp ESC   &tog GAME
        //                      Ctrl      Shift                  Space     Tab
                                &kp LCTRL &kp LSHFT              &kp SPACE &kp TAB
            >;
        };

        sys_layer {
            bindings = <
        //  BOOT      RESET     ·         ·         ·            BT0       BT1       BT2       BT CLR    ·
            &bootloader &sys_reset &none  &none     &none        &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_CLR &none
        //  ·         ·         ·         ·         ·            ·         ·         ·         ·         ·
            &none     &none     &none     &none     &none        &none     &none     &none     &none     &none
        //  GAME      ·         ·         ·         ·            ·         ·         ·         ·         ·
            &tog GAME &none     &none     &none     &none        &none     &none     &none     &none     &none
                                &none     &none                  &none     &none
            >;
        };
    };
};
